<Project>
  <!-- Stand-in for the harness's shared build settings until the build package exists. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>All</AnalysisMode>
  </PropertyGroup>
  <!-- The size and complexity limits, as a product repo sets them up. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory).github/SonarLint.xml" Link="SonarLint.xml" />
  </ItemGroup>
</Project>
