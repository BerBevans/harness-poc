{
  "env": {
    "NUGET_PACKAGES": "/home/<user>/.cache/agent-nuget/packages",
    "NUGET_HTTP_CACHE_PATH": "/home/<user>/.cache/agent-nuget/http-cache"
  },
  "permissions": {
    "additionalDirectories": ["~/src/harness-journal"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/agent-nuget",
        "~/.claude/twin",
        "/mnt/c/Users/<windows-user>/.claude/twin"
      ],
      "denyWrite": [
        "~/.gitconfig",
        "~/.config/git",
        "~/.claude/twin/.git/hooks",
        "~/.claude/twin/.git/config",
        "/mnt/c/Users/<windows-user>/.claude/twin/.git/hooks",
        "/mnt/c/Users/<windows-user>/.claude/twin/.git/config",
        "~/src/harness-journal/.git/hooks",
        "~/src/harness-journal/.git/config"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "api.nuget.org",
        "www.nuget.org",
        "*.blob.core.windows.net",
        "registry.npmjs.org"
      ]
    }
  }
}
