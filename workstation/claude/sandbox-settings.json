{
  "env": {
    "NUGET_PACKAGES": "/home/<user>/.cache/agent-nuget/packages",
    "NUGET_HTTP_CACHE_PATH": "/home/<user>/.cache/agent-nuget/http-cache"
  },
  "permissions": {
    "additionalDirectories": ["~/src/harness-journal"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.claude/.credentials.json",
        "/mnt/c/Users/<windows-user>/.ssh",
        "/mnt/c/Users/<windows-user>/.aws",
        "/mnt/c/Users/<windows-user>/.azure",
        "/mnt/c/Users/<windows-user>/.claude/.credentials.json"
      ],
      "allowWrite": [
        "~/.npm",
        "~/.cache/agent-nuget",
        "~/.claude/twin",
        "/mnt/c/Users/<windows-user>/.claude/twin"
      ],
      "denyWrite": [
        "~/.gitconfig",
        "~/.config/git",
        "~/.local/bin",
        "~/.local/share/claude",
        "~/.profile",
        "~/.bash_profile",
        "~/.bash_login",
        "~/.bashrc",
        "~/.bash_logout",
        "~/.config/systemd/user",
        "~/.config/environment.d",
        "~/.npm/_npx",
        "/mnt/c/Users/<windows-user>/.local/bin",
        "/mnt/c/Users/<windows-user>/.claude.json",
        "/mnt/c/Users/<windows-user>/.claude/settings.json",
        "/mnt/c/Users/<windows-user>/.claude/settings.local.json",
        "/mnt/c/Users/<windows-user>/.claude/hooks",
        "/mnt/c/Users/<windows-user>/.claude/plugins",
        "/mnt/c/Users/<windows-user>/.claude/agents",
        "/mnt/c/Users/<windows-user>/.claude/skills",
        "/mnt/c/Users/<windows-user>/.claude/commands",
        "/mnt/c/Users/<windows-user>/.claude/CLAUDE.md",
        "/mnt/c/Users/<windows-user>/Documents/WindowsPowerShell",
        "/mnt/c/Users/<windows-user>/Documents/PowerShell",
        "/mnt/c/Users/<windows-user>/OneDrive/Documents/WindowsPowerShell",
        "/mnt/c/Users/<windows-user>/OneDrive/Documents/PowerShell",
        "/mnt/c/Users/<windows-user>/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Startup",
        "~/.claude/twin/.git/hooks",
        "~/.claude/twin/.git/config",
        "/mnt/c/Users/<windows-user>/.claude/twin/.git/hooks",
        "/mnt/c/Users/<windows-user>/.claude/twin/.git/config",
        "~/src/harness-journal/.git/hooks",
        "~/src/harness-journal/.git/config"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "api.nuget.org",
        "registry.npmjs.org"
      ]
    }
  }
}
